{
  "version": "1.0.0",
  "configurations": [
    {
      "name": "MEA-System",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"],
      "env": { "NODE_OPTIONS": "--inspect" }
    }
  ]
}
